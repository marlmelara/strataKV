---
# A deliberately curated list rather than a broad one.
#
# The families below are the ones that find real defects: memory and lifetime
# mistakes, misuse of the standard library, and silent conversions. The
# stylistic families are off, and each exclusion below says why, because a
# check list that has to be suppressed at hundreds of call sites teaches
# nothing -- a clean run should actually mean something.
Checks: >
  bugprone-*,
  performance-*,
  misc-*,
  modernize-avoid-c-arrays,
  modernize-deprecated-headers,
  modernize-loop-convert,
  modernize-use-auto,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  readability-const-return-type,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  readability-redundant-control-flow,
  readability-redundant-string-cstr,
  readability-redundant-string-init,
  readability-simplify-boolean-expr,
  readability-string-compare,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-internal-linkage,
  -misc-use-anonymous-namespace,
  -misc-const-correctness,
  -bugprone-empty-catch

# Excluded, with reasons:
#
#   readability-braces-around-statements
#     The engine uses `if (auto s = f(); !s.ok()) return s;` on one line
#     throughout, which is the LevelDB house style and is what the ten
#     learning-guide snippets look like. Adding braces to every one of them
#     would make the code diverge from the teaching material for no gain.
#
#   modernize-use-nodiscard
#     Status is already marked [[nodiscard]] at class scope, which covers every
#     function returning one. Annotating each individual getter adds noise.
#
#   modernize-use-trailing-return-type
#     Rewrites every signature as `auto f() -> T`. Pure churn, and harder to
#     read for someone new to C++.
#
#   modernize-return-braced-init-list
#     Would turn `return Status();` into `return {};`. The explicit form says
#     what it constructs, which matters more than brevity here.
#
#   readability-make-member-function-const
#   readability-convert-member-functions-to-static
#   readability-non-const-parameter
#     These fire on virtual overrides, whose signatures are fixed by the base
#     class and cannot be changed.
#
#   misc-use-internal-linkage
#   misc-use-anonymous-namespace
#     Fire on crc32c::Value and crc32c::Extend, which are declared in crc32c.h
#     and used by the tests, so internal linkage would break the build.
#
#   misc-const-correctness
#     Suggests const-qualifying the pointee of a pointer that a function's whole
#     contract is to hand back as writable memory, such as Arena::Allocate's
#     return value. Taking the advice would not compile.
#
#   bugprone-empty-catch
#     DBImpl's destructor has to swallow whatever Close() throws, because a
#     destructor may not let an exception escape and there is nowhere to report
#     one. The empty handler is the point, not an oversight.
#
#   readability-identifier-length, readability-magic-numbers
#     `fd`, `n`, `i` are clearer than any longer name, and file modes like 0644
#     are more readable as themselves than behind a constant.

WarningsAsErrors: '*'
HeaderFilterRegex: '(include/stratakv|src)/.*\.h$'
FormatStyle: file

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '40'
